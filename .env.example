DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
JWT_SECRET=replace-with-a-long-random-string

# Neon Auth (Stack Auth) - from your Neon Console: project -> Auth tab
STACK_PROJECT_ID=replace-with-your-stack-project-id
STACK_PUBLISHABLE_CLIENT_KEY=replace-with-your-stack-publishable-client-key
